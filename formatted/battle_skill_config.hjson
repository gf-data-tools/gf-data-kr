  {
    id: 60030201
    name: 처형의 피날레
    skill_group_id: 600302
    level: 1
    type: 6
    skill_priority: 2
    cd_type: 1
    cd_time: 150
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    is_form_action: 1
    buff_id_self: 60004:1,60005:1,60018:1,60019:1,60023:1,60024:1,60025:1
    description:
      '''
