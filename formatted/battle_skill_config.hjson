  {
    id: 11660101
    name: 고르곤의 눈
    skill_group_id: 116601
    level: 1
    type: 1
    skill_priority: 5
    cd_type: 1
    cd_time: 90
    start_cd_time: 90
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
